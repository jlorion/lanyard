{
  "name": "lanyard-ssh",
  "productName": "Lanyard",
  "version": "1.0.0",
  "description": "Lanyard: switch git accounts (GitHub, GitLab, Hugging Face, ...) and manage SSH hosts, keys, ssh-agent and known_hosts, from the system tray or the command line.",
  "keywords": [
    "ssh",
    "ssh-config",
    "git",
    "github",
    "gitlab",
    "huggingface",
    "multiple-accounts",
    "ssh-keys",
    "cli",
    "electron"
  ],
  "author": "riomar",
  "license": "MIT",
  "main": "out/main/index.js",
  "bin": {
    "lanyard": "bin/lanyard.js",
    "lny": "bin/lanyard.js",
    "lanyard-ssh": "bin/lanyard.js"
  },
  "files": [
    "bin/",
    "out/main/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/make-icons.mjs",
    "dist": "npm run typecheck && npm run build && electron-builder",
    "lanyard": "node bin/lanyard.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@fontsource/lato": "^5.3.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.52.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "simple-icons": "^16.34.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
