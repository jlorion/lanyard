{
  "name": "ssh-manager",
  "productName": "SSH Manager",
  "version": "1.0.0",
  "description": "Desktop + CLI tool to manage SSH config hosts, keys, the ssh-agent, known_hosts and per-provider git accounts (GitHub, GitLab, Bitbucket, Hugging Face, ...).",
  "author": "riomar",
  "license": "MIT",
  "main": "out/main/index.js",
  "bin": {
    "sshm": "bin/sshm.js"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/make-icons.mjs",
    "dist": "npm run typecheck && npm run build && electron-builder",
    "sshm": "node bin/sshm.js"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
