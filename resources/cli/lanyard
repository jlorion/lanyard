#!/bin/sh
# lanyard CLI shim for the installed macOS / Linux app (resources/cli/lanyard).
# Runs the bundled CLI with the app's own Electron binary in Node mode.
# Symlink it onto your PATH, e.g.  ln -s "<this file>" /usr/local/bin/lanyard
set -e
SELF="$0"
while [ -L "$SELF" ]; do
  TARGET="$(readlink "$SELF")"
  case "$TARGET" in /*) SELF="$TARGET" ;; *) SELF="$(dirname "$SELF")/$TARGET" ;; esac
done
DIR="$(cd "$(dirname "$SELF")" && pwd)"
if [ "$(uname)" = "Darwin" ]; then
  APP="$DIR/../../MacOS/Lanyard"
else
  APP="$DIR/../../lanyard"
fi
export LANYARD_APP_EXE="$APP"
ELECTRON_RUN_AS_NODE=1 exec "$APP" "$DIR/../app.asar/bin/lanyard.js" "$@"
